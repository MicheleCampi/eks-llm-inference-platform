# Charts ArgoCD deploys, checked by ci/validate-gitops.sh: version equal to
# the Application, SHA-256 of the pulled chart equal to the pin.
ESO_CHART_VERSION=2.6.0
ESO_CHART_SHA256=f3659c0085a41e1be5c016cf186b80aac262ef249a91b1b770b941f18296ef3f
ALLOY_CHART_VERSION=1.10.0
ALLOY_CHART_SHA256=abc71e8a846065b48f0f983bdc37b89c465690f1797c3df314dee4c5019db5d5
# Alloy v1.17.0 by digest (same pin as gke), to validate the configuration.
ALLOY_IMAGE=mirror.gcr.io/grafana/alloy@sha256:41c41849989b7e054ccbadc17938ee1e5592fe26bfbc56ef3ffc109c0b0b2739
# ArgoCD is installed from the v3.4.3 manifest (README): its Application CRD
# validates gitops/apps/*.yaml.
ARGOCD_APP_CRD_URL=https://raw.githubusercontent.com/argoproj/argo-cd/v3.4.3/manifests/crds/application-crd.yaml
ARGOCD_APP_CRD_SHA256=fa8a0c7f8127f85bbbf57467e7c659ec7d47e7d162cc76c1b07482ebf2b98f49
# promtool, from the Prometheus image pinned in vllm-coldstart-operator
# (hack/scale-out/prometheus.yaml), for the Karpenter alert rules.
PROM_IMAGE=mirror.gcr.io/prom/prometheus:v3.15.0@sha256:efd719c99d83b060d9daefdcf00360461adf279f45ef5391f8d111892118753e
