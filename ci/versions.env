# Charts ArgoCD deploys, checked by ci/validate-gitops.sh: version equal to
# the Application, SHA-256 of the pulled chart equal to the pin.
ESO_CHART_VERSION=2.15.0
ESO_CHART_SHA256=ed94d41cc67e392ea45e370345eb491b0fdc21387f1aaaefcf8e2e6c85089e1d
ALLOY_CHART_VERSION=1.16.0
ALLOY_CHART_SHA256=efb95c875245af3c73a93b50331dfcece7cd573d5f788d934748a741c9c1747a
# Alloy v1.22.0 (the app version of chart 1.16.0) by tag and digest, to
# validate the configuration with the Alloy that runs it.
ALLOY_IMAGE=mirror.gcr.io/grafana/alloy:v1.22.0@sha256:9acc2529bc1edb7f5b2bd801dd8334ebc80c158e3a9e5526ecd7c9a273d43189
# ArgoCD is installed from the v3.6.2 manifest (README): its Application CRD
# validates gitops/apps/*.yaml.
ARGOCD_APP_CRD_URL=https://raw.githubusercontent.com/argoproj/argo-cd/v3.6.2/manifests/crds/application-crd.yaml
ARGOCD_APP_CRD_SHA256=9fd0da3e7097ad6d1af614fabd5c960bc7ddb00d768c3ef485a2fda6e9460df8
# AppProject, same release: tenancy and team projects (gitops/apps/projects.yaml, team-*.yaml).
ARGOCD_PROJECT_CRD_URL=https://raw.githubusercontent.com/argoproj/argo-cd/v3.6.2/manifests/crds/appproject-crd.yaml
ARGOCD_PROJECT_CRD_SHA256=084150a2feccd188a1dee09cd8a3a259dfacecdfb7e10037df78900f60816482
# promtool, from the Prometheus image pinned in vllm-coldstart-operator
# (hack/scale-out/prometheus.yaml), for the Karpenter alert rules.
PROM_IMAGE=mirror.gcr.io/prom/prometheus:v3.15.0@sha256:efd719c99d83b060d9daefdcf00360461adf279f45ef5391f8d111892118753e
# Kyverno: chart and the CLI that tests gitops/policies offline (v1.20.0,
# SHA-256 from the release checksums.txt).
KYVERNO_CHART_VERSION=3.10.0
KYVERNO_CHART_SHA256=55961392dc0821eb367323f0e9585c061dd4407ef7ada921bd56ea1642c2a301
KYVERNO_CLI_URL=https://github.com/kyverno/kyverno/releases/download/v1.20.0/kyverno-cli_v1.20.0_linux_x86_64.tar.gz
KYVERNO_CLI_SHA256=06b8f3ca7b5626473be8fb4d343ad54ab84e317142766f72420e7d44b80942e2
# kube-state-metrics: pod requests and labels for the right-sizing dashboard.
KSM_CHART_VERSION=9.0.1
KSM_CHART_SHA256=1a06f8bb44c545ade532f26ed11d8ae84753220e8c02e93c129618d9157420a5
