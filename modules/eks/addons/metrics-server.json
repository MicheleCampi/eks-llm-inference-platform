{
  "replicas": 2,
  "podDisruptionBudget": {
    "enabled": true,
    "maxUnavailable": 1
  },
  "topologySpreadConstraints": [
    {
      "maxSkew": 1,
      "topologyKey": "topology.kubernetes.io/zone",
      "whenUnsatisfiable": "ScheduleAnyway",
      "labelSelector": {
        "matchLabels": {
          "app.kubernetes.io/name": "metrics-server",
          "app.kubernetes.io/instance": "metrics-server"
        }
      }
    }
  ],
  "resources": {
    "requests": {
      "cpu": "100m",
      "memory": "200Mi"
    }
  }
}
