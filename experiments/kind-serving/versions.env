# Pinned versions for the kind serving comparison (read 2026-11-18 from
# the projects' git tags). cert-manager is the version KServe v0.21.0 tests
# with (its kserve-deps.env), not the latest.
KIND_VERSION_MIN=v0.30.0
KSERVE_VERSION=v0.21.0
CERT_MANAGER_VERSION=v1.17.0
KUEUE_VERSION=0.20.6
OPERATOR_VERSION=v0.13.0
# Same model, image and engine flags as tests/live/inference-cpu.yaml, so the
# comparison is about the control plane, not the server.
MODEL=Qwen/Qwen2.5-0.5B-Instruct
VLLM_CPU_IMAGE=public.ecr.aws/q9t5s3a7/vllm-cpu-release-repo:v0.11.2@sha256:459b4aa1f3d2fbb603e0f8dadb62d952a18760c087d73fd8c4465fae9b155e8a
CLUSTER=serving-cmp
